<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Theme applied to the Android Window while the process is starting when the OS's
         Activity.onCreate is called before the Flutter rendering framework is fully
         initialized. This theme is visible to the user. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <!-- Show a splash screen on the activity, used to avoid any white flashes. -->
        <item name="android:windowBackground">@drawable/launch_background</item>
    </style>

    <!-- Theme applied to the Android Window as soon as the Flutter rendering framework
         is initialized. This theme determines what the Android Window looks like while
         your Flutter app initializes, as well as behind your Flutter app while it is
         running. -->
    <style name="NormalTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">?android:colorBackground</item>
    </style>
</resources>
