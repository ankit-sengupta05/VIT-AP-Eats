rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helper functions ──────────────────────────────────────
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function hasRole(role) {
      return isSignedIn() && request.auth.token.role == role;
    }

    function isAdmin() {
      return hasRole("admin");
    }

    function isPartner() {
      return hasRole("partner") || isAdmin();
    }

    // ── Users ─────────────────────────────────────────────────
    // Customers can read/write only their own profile.
    // Admins can read any user profile.
    match /users/{uid} {
      allow read:  if isOwner(uid) || isAdmin();
      allow write: if isOwner(uid);
      // Prevent customers from elevating their own role
      allow update: if isOwner(uid) &&
        (!request.resource.data.keys().hasAny(["role"]));
    }

    // ── Restaurants ───────────────────────────────────────────
    // Public read. Only admins can create/update/delete restaurants.
    match /restaurants/{restaurantId} {
      allow read:   if true;
      allow create: if isAdmin();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // ── Menu Items ────────────────────────────────────────────
    // Public read. Only partners (and admins) can write menu items.
    match /menu_items/{itemId} {
      allow read:   if true;
      allow create: if isPartner();
      allow update: if isPartner();
      allow delete: if isAdmin();
    }

    // ── Orders ────────────────────────────────────────────────
    match /orders/{orderId} {
      // Customers can only read their own orders.
      // Partners and admins can read all orders.
      allow read: if isSignedIn() && (
        resource.data.userId == request.auth.uid ||
        isPartner()
      );

      // Customers can create an order only if userId matches their uid.
      // They cannot set any privileged fields.
      allow create: if isSignedIn() &&
        request.resource.data.userId == request.auth.uid &&
        !request.resource.data.keys().hasAny(["adminNote", "partnerNote"]);

      // Customers can only cancel their own pending orders.
      // Partners and admins can update any order (status changes).
      allow update: if isSignedIn() && (
        // Partner/admin can update anything
        isPartner() ||
        // Customer can only cancel their own order, nothing else
        (resource.data.userId == request.auth.uid &&
         request.resource.data.diff(resource.data).affectedKeys().hasOnly(["status"]) &&
         request.resource.data.status == "cancelled" &&
         resource.data.status == "pending")
      );

      // Only admins can permanently delete orders.
      allow delete: if isAdmin();
    }

    // ── Partner Applications ──────────────────────────────────
    // Signed-in users can submit and read their own application.
    // Admins can read all and update the status.
    match /partner_applications/{appId} {
      allow read:   if isSignedIn() && (resource.data.uid == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && request.resource.data.uid == request.auth.uid;
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }
  }
}
